---
layout: base.njk
title: Resume | Benson Fung
description: Professional experience and skills of Benson Fung, systems builder and engineering leader.
permalink: /resume/index.html
---

<a href="/" class="back-link print-hide">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;">
    <line x1="19" y1="12" x2="5" y2="12"></line>
    <polyline points="12 19 5 12 12 5"></polyline>
  </svg>
  Back to Home
</a>

<div class="resume-container">
  <header class="resume-header">
    <div>
      <h1 style="margin-bottom: 4px;">{{ site.name }}</h1>
      <p style="font-size: 1.1rem; font-weight: 500; color: var(--color-accent); margin-bottom: 8px;">
        {{ profile.title }}
      </p>
      <p style="font-size: 0.95rem; line-height: 1.4; max-width: 550px;">
        {{ profile.summary }}
      </p>
    </div>
    <div class="resume-contact">
      <span>{{ profile.location }}</span>
      <span>{% for s in profile.socials %}{% if s.id == "linkedin" %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.display }}</a>{% endif %}{% endfor %}</span>
      <span>{% for s in profile.socials %}{% if s.id == "github" %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.display }}</a>{% endif %}{% endfor %}</span>
    </div>
  </header>

  <div class="resume-layout">
    <!-- Left Column: Main content -->
    <div class="resume-main">
      <h2 class="resume-section-title">Experience</h2>
      <div class="timeline">
        {% for job in resume.experience %}
        <div class="timeline-item">
          <div class="timeline-header">
            <h3 class="timeline-title">{{ job.title }}</h3>
            <span class="timeline-date">{{ job.start }} &ndash; {{ job.end }}</span>
          </div>
          <div class="timeline-subtitle">
            <span class="timeline-company">{% if job.companyUrl %}<a href="{{ job.companyUrl }}" target="_blank" rel="noopener">{{ job.company }}</a>{% else %}{{ job.company }}{% endif %}</span>{% if job.companyNote %} ({{ job.companyNote }}){% endif %} &bull; {{ job.location }}
          </div>
          <div class="timeline-content">
            <ul>
              {% for b in job.bulletsHtml %}<li>{{ b | safe }}</li>
              {% endfor %}
            </ul>
            <div class="tech-pills">
              {% for tag in job.tags %}<span class="tech-pill">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      <h2 class="resume-section-title" style="margin-top: var(--space-xxl);">Education</h2>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-header">
            <h3 class="timeline-title">{{ resume.education.school }}</h3>
            <span class="timeline-date">{{ resume.education.start }} &ndash; {{ resume.education.end }}</span>
          </div>
          <div class="timeline-subtitle">
            {{ resume.education.degree }} &bull; {{ resume.education.detail }}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Sidebar / Skills & Tech -->
    <div class="resume-sidebar">
      <h2 class="resume-section-title">Skills</h2>
      <div class="skills-block">
        <h3 class="skills-category">Core Expertise</h3>
        <ul class="skills-list">
          {% for skill in resume.coreSkills %}<li class="skill-badge">{{ skill }}</li>
          {% endfor %}
        </ul>
      </div>

      <h2 class="resume-section-title">Technologies</h2>
      {% for group in resume.skillGroups %}
      <div class="skills-block">
        <h3 class="skills-category">{{ group.category }}</h3>
        <ul class="skills-list">
          {% for skill in group.items %}<li class="skill-badge">{{ skill }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
