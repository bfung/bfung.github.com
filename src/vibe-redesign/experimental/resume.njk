<style>
/* ============ TOKENS ============ */
:root{
  --void:#101013;
  --bone:#F2EFE3;
  --lime:#C8FF1E;
  --red:#FF3131;
  --violet:#6E56CF;
  --display:Impact,"Arial Black","Franklin Gothic Heavy","Helvetica Neue",sans-serif;
  --mono:ui-monospace,"Cascadia Mono","SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --serif:Georgia,"Iowan Old Style","Palatino Linotype",Palatino,serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{overflow-x:hidden}
body{
  overflow-x:clip;
  background:var(--void);
  color:var(--bone);
  font-family:var(--mono);
  font-size:1rem;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--lime);color:#000}
a{color:var(--lime)}
:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
h1,h2,h3{font-family:var(--display);font-weight:400;text-transform:uppercase}
.skip{
  position:fixed;top:-60px;left:12px;z-index:999;
  background:var(--lime);color:#000;font-family:var(--mono);font-weight:700;
  padding:.7rem 1.1rem;text-decoration:none;transition:top .2s;
}
.skip:focus{top:12px}

/* ============ BOOT ============ */
.boot{
  position:fixed;inset:0;z-index:500;background:var(--void);
  display:flex;align-items:center;justify-content:center;
  transition:opacity .4s ease,visibility .4s;
  animation:bootkill .6s ease 6s forwards;
}
@keyframes bootkill{to{opacity:0;visibility:hidden}}
.boot.done{opacity:0;visibility:hidden;animation:none}
.boot pre{
  font-family:var(--mono);font-size:clamp(.9rem,2.4vw,1.15rem);color:var(--lime);
  white-space:pre-wrap;padding:0 24px;max-width:640px;
}
.boot pre .ok{color:var(--bone)}
#booskip{
  position:absolute;bottom:28px;right:28px;background:transparent;color:var(--bone);
  border:2px solid var(--bone);font-family:var(--mono);font-weight:700;font-size:.8rem;
  letter-spacing:.12em;padding:.6rem 1.2rem;cursor:pointer;
}
#booskip:hover{background:var(--bone);color:#000}

/* ============ CURSOR ============ */
.cdot,.cring{display:none}
body.has-cursor{cursor:none}
body.has-cursor a,body.has-cursor button{cursor:none}
body.has-cursor .cdot,body.has-cursor .cring{display:flex}
.cdot{
  position:fixed;z-index:600;width:10px;height:10px;border-radius:50%;
  background:var(--lime);pointer-events:none;transform:translate(-50%,-50%);
  mix-blend-mode:difference;
}
.cring{
  position:fixed;z-index:600;min-width:38px;height:38px;border-radius:999px;
  border:2px solid var(--lime);pointer-events:none;transform:translate(-50%,-50%);
  mix-blend-mode:difference;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:.62rem;font-weight:700;letter-spacing:.1em;color:var(--lime);
  transition:width .18s,height .18s,background .18s;white-space:nowrap;padding:0 10px;
}
.cring .clabel{display:none}
.cring.tagged{background:var(--lime);mix-blend-mode:normal}
.cring.tagged .clabel{display:block;color:#000}
#boba{position:fixed;inset:0;z-index:550;pointer-events:none}

/* ============ HEADER ============ */
.rhead{padding:16vh 5vw 6vh}
.hero-kicker{font-size:.78rem;letter-spacing:.28em;color:var(--violet);margin-bottom:2vh}
.rhead h1{font-size:clamp(3.5rem,14vw,12rem);line-height:.85}
.rhead h1 .alt{color:transparent;-webkit-text-stroke:2px var(--bone)}
@supports not (-webkit-text-stroke:1px black){.rhead h1 .alt{color:var(--bone)}}
.rsub{margin-top:2.5vh;font-size:.8rem;letter-spacing:.18em;opacity:.75}
.backline{margin-top:3vh}
.backline a{
  display:inline-block;border:2px solid var(--lime);color:var(--lime);
  font-weight:700;font-size:.8rem;letter-spacing:.14em;text-decoration:none;padding:.7rem 1.3rem;
}
.backline a:hover{background:var(--lime);color:#000}

/* ============ BOTTOM NAV ============ */
.bottomnav{
  position:fixed;left:0;right:0;bottom:0;z-index:400;
  background:var(--void);border-top:2px solid var(--bone);
  display:flex;justify-content:center;overflow-x:auto;scrollbar-width:none;
}
.bottomnav::-webkit-scrollbar{display:none}
.bottomnav a{
  font-family:var(--mono);font-weight:700;font-size:1rem;letter-spacing:.1em;
  color:var(--bone);text-decoration:none;padding:1rem 1.6rem;flex:none;
  transition:background .18s,color .18s;
}
.bottomnav a:hover,.bottomnav a.active{background:var(--lime);color:#000}
.bottomnav a.home{background:var(--violet);color:#fff}
.bottomnav a.home:hover{background:var(--lime);color:#000}
@media(max-width:640px){.bottomnav a{font-size:.78rem;padding:.9rem .8rem}}

/* ============ SECTIONS ============ */
section{padding:10vh 5vw;position:relative}
.sec-tag{font-size:.75rem;letter-spacing:.3em;color:var(--violet);margin-bottom:2vh}
.sec-title{font-size:clamp(3rem,11vw,10rem);line-height:.9;margin-bottom:4vh}
.sec-title .alt{color:transparent;-webkit-text-stroke:2px var(--bone)}
@supports not (-webkit-text-stroke:1px black){.sec-title .alt{color:var(--bone)}}
.sec-title .lime{color:var(--lime)}
.wipe{clip-path:inset(0 0 100% 0);transition:clip-path .8s cubic-bezier(.22,1,.36,1)}
.wipe.in{clip-path:inset(0 0 0% 0)}

/* work rows */
.job{border-top:2px solid var(--bone)}
.job:last-of-type{border-bottom:2px solid var(--bone)}
.job-head{
  width:100%;background:transparent;border:none;color:var(--bone);text-align:left;
  display:grid;grid-template-columns:auto 1fr auto;gap:1.5rem;align-items:center;
  padding:2.2rem 1rem;cursor:pointer;font-family:inherit;
  transition:background .15s;
}
.job-head:hover{background:var(--red)}
.job-head:hover .jtitle,.job-head:hover .jidx{color:#000}
.job-head:hover .jstamp{background:#000;color:var(--red)}
.jidx{
  font-family:var(--display);font-size:clamp(3rem,10vw,7rem);line-height:1;
  color:transparent;-webkit-text-stroke:2px var(--violet);
}
@supports not (-webkit-text-stroke:1px black){.jidx{color:var(--violet)}}
.jtitle{font-family:var(--display);font-size:clamp(1.7rem,5.5vw,4.2rem);line-height:.95}
.jmeta{display:flex;flex-direction:column;align-items:flex-end;gap:.7rem}
.jstamp{
  background:var(--lime);color:#000;font-weight:700;font-size:.72rem;letter-spacing:.08em;
  padding:.45rem .9rem;transform:rotate(2deg);white-space:nowrap;
}
.jperiod{font-size:.75rem;letter-spacing:.14em;opacity:.8}
.jplus{font-size:1.6rem;color:var(--lime);font-weight:700;transition:transform .3s}
.job.open .jplus{transform:rotate(45deg)}
.job-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)}
.job.open .job-body{grid-template-rows:1fr}
.job-body-inner{overflow:hidden}
.job-body-inner .pad{padding:0 1rem 2.4rem 1rem}
.job-body ul{list-style:none;margin-bottom:1.4rem;max-width:70ch}
.job-body ul li{padding-left:1.6rem;position:relative;margin-bottom:.6rem;font-size:1rem}
.job-body ul li::before{content:">";position:absolute;left:0;color:var(--lime);font-weight:700}
.job-body ul a{color:var(--bone);text-decoration:underline;text-decoration-color:var(--lime);text-underline-offset:3px}
.jtags{display:flex;flex-wrap:wrap;gap:.5rem}
.jtags span{border:1px solid var(--bone);font-size:.68rem;letter-spacing:.12em;padding:.35rem .8rem}
@media(max-width:760px){
  .job-head{grid-template-columns:auto 1fr;gap:1rem}
  .jmeta{grid-column:1/-1;flex-direction:row;align-items:center;justify-content:flex-start}
}

/* skills */
.wall{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
@media(max-width:1000px){.wall{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.wall{grid-template-columns:1fr}}
.zone{border:2px solid var(--bone);padding:0;position:relative;background:rgba(242,239,227,.02)}
.zone-head{
  width:100%;background:transparent;border:none;border-bottom:2px solid var(--bone);
  color:var(--bone);font-family:var(--mono);font-weight:700;font-size:.75rem;letter-spacing:.22em;
  padding:1rem 1.2rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;
}
.zone-head:hover{background:var(--bone);color:#000}
.zone-head .shuf{font-size:.62rem;letter-spacing:.14em;color:var(--violet)}
.zone-head:hover .shuf{color:var(--red)}
.tags{display:flex;flex-wrap:wrap;gap:.55rem;padding:1.2rem;transition:opacity .25s}
.tags.fading{opacity:0}
.tag{
  font-size:.8rem;border:1px solid var(--bone);padding:.4rem .85rem;
  transition:transform .15s,background .15s,color .15s;user-select:none;
}
.tag:hover{background:#000;color:var(--lime);border-color:var(--lime);transform:scale(1.15)}
.counter{margin-top:4vh;font-size:.8rem;letter-spacing:.18em;color:var(--bone);opacity:.8}
.counter b{color:var(--lime)}

/* education */
.edu-big{
  font-family:var(--display);font-size:clamp(2.2rem,8vw,7rem);line-height:.95;
  color:transparent;-webkit-text-stroke:2px var(--bone);max-width:20ch;
}
@supports not (-webkit-text-stroke:1px black){.edu-big{color:var(--bone)}}
.edu-stamp{
  display:inline-block;background:var(--red);color:#fff;font-weight:700;font-size:.85rem;
  letter-spacing:.1em;padding:.6rem 1.1rem;transform:rotate(-4deg);margin-top:3vh;
}

/* footer */
footer{
  border-top:2px solid var(--bone);padding:2.2rem 5vw 7rem;
  display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;
  font-size:.75rem;letter-spacing:.12em;
}
footer a{color:var(--lime)}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .boot{display:none}
  .wipe{clip-path:none}
}
</style>
<noscript><style>.boot{display:none!important}</style></noscript>
