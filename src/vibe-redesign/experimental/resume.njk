  <a href="#work" data-sec="work">WORK</a>
  <a href="#skills" data-sec="skills">SKILLS</a>
  <a href="/vibe-redesign/experimental/">&larr; HOME</a>
  <a class="home" href="/vibe-redesign/">../</a>
</nav>

<script>
(function(){
  "use strict";
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var finePointer = window.matchMedia('(pointer: fine)').matches;

  /* ---------- BOOT SEQUENCE ---------- */
  var boot = document.getElementById('boot');
  var bootlog = document.getElementById('bootlog');
  var lines = [
    '> workfiles.exe \u2014 7 jobs found',
    '> unsealing case files\u2026 '
  ];
  function killBoot(){
    if (!boot || boot.classList.contains('done')) return;
    boot.classList.add('done');
    setTimeout(function(){ if (boot.parentNode) boot.parentNode.removeChild(boot); }, 500);
  }
  document.getElementById('booskip').addEventListener('click', killBoot);
  if (reduceMotion) {
    killBoot();
  } else if (bootlog) {
    var li = 0, ci = 0, html = '';
    function type(){
      if (li >= lines.length) {
        html += '<span class="ok">done.</span>';
        bootlog.innerHTML = html;
        setTimeout(killBoot, 450);
        return;
      }
      var line = lines[li];
      if (ci <= line.length) {
        bootlog.innerHTML = html + line.slice(0, ci) + '<span class="ok">\u2588</span>';
        ci++;
        setTimeout(type, 14);
      } else {
        html += line + '<span class="ok">ok</span>\n';
        li++; ci = 0;
        setTimeout(type, 120);
      }
    }
    type();
  }

  /* ---------- CUSTOM CURSOR ---------- */
  if (finePointer && !reduceMotion) {
    document.body.classList.add('has-cursor');
    var dot = document.getElementById('cdot');
    var ring = document.getElementById('cring');
    var clabel = document.getElementById('clabel');
    var mx = -100, my = -100, rx = -100, ry = -100;
    document.addEventListener('mousemove', function(e){
      mx = e.clientX; my = e.clientY;
      dot.style.left = mx + 'px'; dot.style.top = my + 'px';
    });
    (function loop(){
      rx += (mx - rx) * 0.16; ry += (my - ry) * 0.16;
      ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
      requestAnimationFrame(loop);
    })();
    document.querySelectorAll('[data-cursor]').forEach(function(el){
      el.addEventListener('mouseenter', function(){
        clabel.textContent = el.getAttribute('data-cursor');
        ring.classList.add('tagged');
      });
      el.addEventListener('mouseleave', function(){
        ring.classList.remove('tagged');
      });
    });
  }

  /* ---------- SCROLL REVEALS ---------- */
  var wipeEls = document.querySelectorAll('.wipe');
  if ('IntersectionObserver' in window && !reduceMotion) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2 });
    wipeEls.forEach(function(el){ io.observe(el); });
  } else {
    wipeEls.forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- JOB ACCORDIONS ---------- */
  document.querySelectorAll('.job-head').forEach(function(btn){
    btn.addEventListener('click', function(){
      var job = btn.closest('.job');
      var open = job.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('data-cursor', open ? 'SHUT' : 'OPEN');
    });
  });

  /* ---------- SKILL SHUFFLE ---------- */
  document.querySelectorAll('.zone').forEach(function(zone){
    var head = zone.querySelector('.zone-head');
    var tags = zone.querySelector('.tags');
    head.addEventListener('click', function(){
      tags.classList.add('fading');
      setTimeout(function(){
        var kids = Array.prototype.slice.call(tags.children);
        for (var i = kids.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = kids[i]; kids[i] = kids[j]; kids[j] = tmp;
        }
        kids.forEach(function(k){ tags.appendChild(k); });
        tags.classList.remove('fading');
      }, 260);
    });
  });

  /* ---------- BOBA MODE ---------- */
  var canvas = document.getElementById('boba');
  var bobaRunning = false;
  function bobaMode(){
    if (bobaRunning || reduceMotion || !canvas) return;
    bobaRunning = true;
    canvas.hidden = false;
    var ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    var pearls = [];
    var colors = ['#C8FF1E', '#F2EFE3', '#C8FF1E', '#FF3131'];
    for (var i = 0; i < 14; i++) {
      pearls.push({
        x: Math.random() * canvas.width,
        y: -30 - Math.random() * 120,
        vx: (Math.random() - 0.5) * 7,
        vy: Math.random() * 3,
        r: 12 + Math.random() * 14,
        c: colors[i % colors.length]
      });
    }
    var start = performance.now(), alpha = 1;
    (function frame(now){
      var t = now - start;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (t > 5200) alpha = Math.max(0, 1 - (t - 5200) / 800);
      ctx.globalAlpha = alpha;
      pearls.forEach(function(p){
        p.vy += 0.22; p.x += p.vx; p.y += p.vy;
        if (p.y + p.r > canvas.height) { p.y = canvas.height - p.r; p.vy *= -0.72; p.vx *= 0.985; }
        if (p.x - p.r < 0) { p.x = p.r; p.vx *= -0.9; }
        if (p.x + p.r > canvas.width) { p.x = canvas.width - p.r; p.vx *= -0.9; }
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.c; ctx.fill();
        ctx.beginPath(); ctx.arc(p.x - p.r * 0.3, p.y - p.r * 0.3, p.r * 0.28, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,.55)'; ctx.fill();
      });
      ctx.globalAlpha = 1;
      if (t < 6200) requestAnimationFrame(frame);
      else { canvas.hidden = true; bobaRunning = false; }
    })(start);
  }
  document.addEventListener('keydown', function(e){
    if ((e.key === 'b' || e.key === 'B') && !e.metaKey && !e.ctrlKey && !e.altKey) {
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag !== 'INPUT' && tag !== 'TEXTAREA') bobaMode();
    }
  });

  /* ---------- BOTTOM NAV ACTIVE STATE ---------- */
  var navLinks = document.querySelectorAll('.bottomnav a[data-sec]');
  var secs = ['work', 'skills'].map(function(id){ return document.getElementById(id); });
  if ('IntersectionObserver' in window) {
    var nio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          navLinks.forEach(function(a){
            a.classList.toggle('active', a.getAttribute('data-sec') === e.target.id);
          });
        }
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    secs.forEach(function(s){ if (s) nio.observe(s); });
  }
})();
</script>
</body>
</html>
