<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resume — Minimalist | VibeRedesign</title>
<meta name="description" content="Benson Fung's resume reduced to the essential: one column, exquisite type, nothing else. The minimalist VibeRedesign.">
<link rel="canonical" href="https://bfung.github.io/vibe-redesign/minimalist/resume/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Benson Fung">
<meta property="og:title" content="Resume — Minimalist | VibeRedesign">
<meta property="og:description" content="Radical restraint: one narrow column, near-black on white, typography carrying everything.">
<meta property="og:url" content="https://bfung.github.io/vibe-redesign/minimalist/resume/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Resume — Minimalist | VibeRedesign">
<meta name="twitter:description" content="Radical restraint: one narrow column, near-black on white, typography carrying everything.">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<style>
:root{
  --paper:#FDFDFB;
  --ink:#141414;
  --muted:#6B6B6B;
  --hairline:#E7E4DA;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--sans);
  font-size:1rem;
  line-height:1.75;
  -webkit-font-smoothing:antialiased;
  animation:rise .5s ease-out;
}
@keyframes rise{from{opacity:0}to{opacity:1}}
::selection{background:var(--ink);color:var(--paper)}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:1px}
a{color:var(--ink);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{color:var(--muted)}

/* skip link */
.skip{
  position:absolute;left:-9999px;top:0;z-index:10;
  background:var(--ink);color:var(--paper);text-decoration:none;
  padding:.6rem 1rem;font-size:.85rem;
}
.skip:focus{left:0}

/* the one column */
.col{max-width:660px;margin:0 auto;padding:0 24px}

/* quiet navigation */
.topnav{
  display:flex;justify-content:space-between;align-items:baseline;
  padding:2.25rem 0;font-size:.85rem;
}
.topnav a.back{color:var(--muted);text-decoration:none}
.topnav a.back:hover{color:var(--ink);text-decoration:underline;text-underline-offset:3px}
.topnav .brand{font-weight:600;color:var(--ink);text-decoration:none;letter-spacing:-0.01em}
.topnav .brand:hover{color:var(--muted)}

/* resume header */
.rhead{padding:8vh 0 0}
.rhead h1{
  font-size:2rem;font-weight:600;letter-spacing:-0.02em;line-height:1.2;
  margin-bottom:.6rem;
}
.rhead .title{color:var(--muted);font-size:1rem;margin-bottom:1.4rem}
.rhead .summary{max-width:58ch;margin-bottom:1.4rem}
.rhead .contactline{font-size:.85rem;color:var(--muted)}
.rhead .contactline a{color:var(--muted)}
.rhead .contactline a:hover{color:var(--ink)}
.rhead .contactline .sep{margin:0 .5rem;color:var(--hairline)}

/* the single hairline — the one decorative whisper on the page */
hr.rule{border:none;border-top:1px solid var(--hairline);margin:4.5rem 0 0}

/* sections: whitespace is the only separator */
section.block{margin:5rem 0}
.label{
  font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
  color:var(--muted);margin-bottom:2.5rem;
}

/* jobs */
.job{margin-bottom:3.5rem}
.job:last-child{margin-bottom:0}
.job h3{font-size:1.12rem;font-weight:600;letter-spacing:-0.01em;line-height:1.4;margin-bottom:.25rem}
.job .meta{font-size:.85rem;color:var(--muted);margin-bottom:1rem}
.job .meta a{color:var(--muted)}
.job .meta a:hover{color:var(--ink)}
.job .meta .sep{margin:0 .45rem;color:var(--hairline)}
.job ul{list-style:none;margin-bottom:1rem}
.job ul li{position:relative;padding-left:1.25rem;margin-bottom:.55rem;font-size:.96rem}
.job ul li::before{content:"\2013";position:absolute;left:0;color:var(--muted)}
.job ul a{color:var(--ink)}
.job .tech{font-size:.85rem;color:var(--muted)}

/* education */
.edu p{font-size:.96rem;margin-bottom:.3rem}
.edu p .when{color:var(--muted);font-size:.85rem}

/* skills */
.skillgroup{margin-bottom:1.75rem}
.skillgroup:last-child{margin-bottom:0}
.skillgroup h3{
  font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--muted);margin-bottom:.4rem;
}
.skillgroup p{font-size:.96rem}

/* footer */
footer.site{margin-top:7rem;padding:2.5rem 0 3.5rem}
footer.site p{font-size:.8rem;color:var(--muted)}
footer.site a{color:var(--muted)}
footer.site a:hover{color:var(--ink)}
footer.site .sep{margin:0 .5rem;color:var(--hairline)}

@media (prefers-reduced-motion: reduce){
  body{animation:none}
  html{scroll-behavior:auto}
  *,*::before,*::after{transition:none !important}
}
@media (max-width:480px){
  .rhead{padding:6vh 0 0}
  .rhead h1{font-size:1.7rem}
  section.block{margin:3.75rem 0}
  hr.rule{margin:3.5rem 0 0}
}
</style>
  <!-- Datadog RUM -->
  <script src="/assets/js/rum-init.js?v=1.0.0" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="col">
  <header class="topnav">
    <a class="back" href="/vibe-redesign/minimalist/">&larr; Home</a>
    <a class="brand" href="/vibe-redesign/minimalist/">{{ site.name }}</a>
  </header>

  <main id="main">
    <div class="rhead">
      <h1>{{ site.name }}</h1>
      <p class="title">{{ profile.title }}</p>
      <p class="summary">{{ profile.summary }}</p>
      <p class="contactline">{{ profile.location }}<span class="sep">&middot;</span>{% for s in profile.socials %}{% if s.id == "linkedin" or s.id == "github" %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>{% if s.id == "linkedin" %}<span class="sep">&middot;</span>{% endif %}{% endif %}{% endfor %}</p>
    </div>

    <hr class="rule">

    <section class="block" aria-labelledby="exp-h">
      <h2 class="label" id="exp-h">Experience</h2>

      {% for job in resume.experience %}
      <article class="job">
        <h3>{{ job.title }}</h3>
        <p class="meta">{% if job.companyUrl %}<a href="{{ job.companyUrl }}" target="_blank" rel="noopener">{{ job.company }}</a>{% else %}{{ job.company }}{% endif %}{% if job.companyNote %} ({{ job.companyNote }}){% endif %}<span class="sep">&middot;</span>{{ job.location }}<span class="sep">&middot;</span>{{ job.start }} &ndash; {{ job.end }}</p>
        <ul>
          {% for b in job.bulletsHtml %}<li>{{ b | safe }}</li>
          {% endfor %}
        </ul>
        <p class="tech">{% for tag in job.tags %}{{ tag }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </article>
      {% endfor %}
    </section>

    <section class="block edu" aria-labelledby="edu-h">
      <h2 class="label" id="edu-h">Education</h2>
      <p>{{ resume.education.school }} <span class="when">&mdash; {{ resume.education.degree }}, {{ resume.education.start }} &ndash; {{ resume.education.end }}</span></p>
      <p><span class="when">{{ resume.education.detail }}</span></p>
    </section>

    <section class="block" aria-labelledby="skills-h">
      <h2 class="label" id="skills-h">Skills</h2>

      <div class="skillgroup">
        <h3>Core Expertise</h3>
        <p>{% for skill in resume.coreSkills %}{{ skill }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </div>
      {% for group in resume.skillGroups %}
      <div class="skillgroup">
        <h3>{{ group.category }}</h3>
        <p>{% for skill in group.items %}{{ skill }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
      </div>
      {% endfor %}
    </section>
  </main>

  <footer class="site">
    <p>&copy; 2026 {{ site.name }}<span class="sep">&middot;</span><a href="/vibe-redesign/minimalist/">&larr; Home</a><span class="sep">&middot;</span><a href="/vibe-redesign/">&larr; All vibes</a></p>
  </footer>
</div>

<script>
(function(){
  "use strict";
  document.documentElement.classList.add("js");
})();
</script>
</body>
</html>
