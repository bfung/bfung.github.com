<style>
:root{
  --bg:#05070A;
  --bg2:#0A0E13;
  --panel:#0C1218;
  --glass:linear-gradient(180deg, rgba(148,163,184,.075), rgba(148,163,184,.022));
  --solid:linear-gradient(180deg, rgba(17,25,35,.94), rgba(9,14,20,.94));
  --border:rgba(148,163,184,.14);
  --border-soft:rgba(148,163,184,.08);
  --text:#E8EEF4;
  --muted:#8B98AB;
  --faint:#5B6B7E;
  --accent:#22D3EE;
  --accent-dim:rgba(34,211,238,.12);
  --accent-glow:rgba(34,211,238,.32);
  --amber:#FBBF24;
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
  --ease:cubic-bezier(.22,1,.36,1);
  --r:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--text);
  font-family:var(--sans);font-size:1.0625rem;line-height:1.65;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
::selection{background:var(--accent);color:#03181c}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3{line-height:1.08;letter-spacing:-.03em;font-weight:800}

/* backdrop layers */
.bg-dots{position:fixed;inset:0;z-index:0;pointer-events:none;transform:translateZ(0);
  background-image:radial-gradient(rgba(148,163,184,.14) 1px, transparent 1.4px);
  background-size:28px 28px;
  -webkit-mask-image:radial-gradient(ellipse 90% 62% at 50% -4%, #000 25%, transparent 78%);
  mask-image:radial-gradient(ellipse 90% 62% at 50% -4%, #000 25%, transparent 78%);}
.orb{position:fixed;z-index:0;pointer-events:none;border-radius:50%}
.orb-a{width:560px;height:380px;left:50%;top:-160px;transform:translateX(-50%) translateZ(0);
  background:radial-gradient(closest-side, rgba(34,211,238,.16), transparent 70%)}
.orb-b{width:420px;height:420px;right:-140px;top:38%;transform:translateZ(0);background:radial-gradient(closest-side, rgba(34,211,238,.07), transparent 70%)}

.wrap{max-width:1080px;margin:0 auto;padding:0 24px;position:relative;z-index:1}
.skip{position:fixed;top:-64px;left:16px;z-index:200;background:var(--accent);color:#03181c;
  font-family:var(--mono);font-size:.8rem;font-weight:700;padding:.7rem 1.1rem;border-radius:8px;
  text-decoration:none;transition:top .2s}
.skip:focus{top:12px}

/* nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:background .25s,border-color .25s;border-bottom:1px solid transparent}
.nav.scrolled{background:rgba(5,7,10,.92);border-bottom-color:var(--border-soft)}
.nav-in{max-width:1080px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{font-family:var(--mono);font-size:.95rem;font-weight:700;color:var(--text);text-decoration:none;letter-spacing:-.01em}
.brand b{color:var(--accent);font-weight:700}
.nav-links{display:flex;gap:26px;list-style:none;align-items:center}
.nav-links a{font-size:.86rem;color:var(--muted);text-decoration:none;transition:color .18s}
.nav-links a:hover{color:var(--text)}
.nav-links a.hl{color:var(--accent);font-weight:600}
@media(max-width:640px){.nav-links{gap:16px}.nav-links a{font-size:.78rem}}

/* reveal */
.js .rv{opacity:0;transform:translateY(14px);transition:opacity .28s var(--ease),transform .28s var(--ease);transition-delay:var(--d,0ms)}
.js .rv.in{opacity:1;transform:none}

/* hero */
.hero{padding:148px 0 72px;text-align:center;position:relative}
.status{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:.5rem 1rem;margin-bottom:28px;
  background:var(--glass),var(--solid)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex:none;position:relative}
.dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--accent);animation:ping 2.2s var(--ease) infinite}
@keyframes ping{0%{transform:scale(1);opacity:.55}60%,100%{transform:scale(2.8);opacity:0}}
.hero h1{font-size:clamp(3rem,8.5vw,5.75rem);margin-bottom:18px;
  background:linear-gradient(180deg,#fff 25%,#9FB0C3 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
@supports not ((-webkit-background-clip:text) or (background-clip:text)){.hero h1{color:var(--text)}}
.tagline{font-size:clamp(1.15rem,2.4vw,1.45rem);color:var(--text);font-weight:600;margin-bottom:6px}
.tagline .boba{color:var(--accent)}
.subline{font-family:var(--mono);font-size:.85rem;color:var(--muted);letter-spacing:.06em;margin-bottom:30px}
.ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:56px}
.btn{display:inline-flex;align-items:center;gap:8px;font-size:.92rem;font-weight:600;text-decoration:none;
  border-radius:999px;padding:.85rem 1.7rem;transition:transform .18s var(--ease),box-shadow .18s,background .18s,border-color .18s}
.btn:active{transform:scale(.98)}
.btn-primary{background:#fff;color:#05070A}
.btn-primary:hover{box-shadow:0 0 28px rgba(34,211,238,.35);transform:translateY(-1px)}
.btn-ghost{border:1px solid var(--border);color:var(--text);background:rgba(12,18,24,.5)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px)}

/* terminal card */
.term{max-width:640px;margin:0 auto;text-align:left;background:var(--glass),var(--solid);
  border:1px solid var(--border);border-radius:var(--r);overflow:hidden;
  box-shadow:0 24px 70px -30px rgba(0,0,0,.8), 0 0 0 1px rgba(0,0,0,.4), 0 0 44px -18px var(--accent-glow)}
.term-bar{display:flex;align-items:center;gap:7px;padding:.7rem 1rem;border-bottom:1px solid var(--border-soft)}
.term-bar i{width:11px;height:11px;border-radius:50%;background:#2A3440}
.term-bar i:nth-child(1){background:#FF5F57}.term-bar i:nth-child(2){background:#FEBC2E}.term-bar i:nth-child(3){background:#28C840}
.term-bar span{margin-left:8px;font-family:var(--mono);font-size:.7rem;color:var(--faint);letter-spacing:.06em}
.term-body{padding:1.2rem 1.3rem 1.4rem;font-family:var(--mono);font-size:.86rem;line-height:1.9;min-height:172px}
.term-body .p{color:var(--accent)}
.term-body .o{color:var(--text)}
.term-body .m{color:var(--muted)}
.caret{display:inline-block;width:9px;height:1.15em;background:var(--accent);vertical-align:text-bottom;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:860px;margin:64px auto 0}
.stat{background:var(--glass);border:1px solid var(--border-soft);border-radius:12px;padding:1.2rem .8rem;transition:border-color .2s,transform .2s var(--ease)}
.stat:hover{border-color:var(--border);transform:translateY(-2px)}
.stat b{display:block;font-size:1.9rem;letter-spacing:-.03em;font-weight:800}
.stat b em{font-style:normal;color:var(--accent)}
.stat span{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
@media(max-width:640px){.stats{grid-template-columns:repeat(2,1fr)}}

/* sections */
section{padding:88px 0;position:relative;scroll-margin-top:64px;content-visibility:auto;contain-intrinsic-size:auto 900px}
.eyebrow{font-family:var(--mono);font-size:.74rem;letter-spacing:.18em;color:var(--accent);margin-bottom:14px}
.eyebrow::before{content:"~/";color:var(--faint)}
.sec-title{font-size:clamp(1.9rem,4vw,2.9rem);margin-bottom:12px}
.sec-sub{color:var(--muted);max-width:60ch;margin-bottom:44px}

/* project cards */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--glass),var(--solid);border:1px solid var(--border-soft);border-radius:var(--r);padding:1.7rem;
  display:flex;flex-direction:column;gap:.7rem;position:relative;overflow:hidden;
  transition:transform .22s var(--ease),border-color .22s,box-shadow .22s}
.card::before{content:"";position:absolute;inset:0;opacity:0;transition:opacity .25s;pointer-events:none;
  background:radial-gradient(420px 200px at 50% -60px, var(--accent-glow), transparent 70%)}
.card:hover{transform:translateY(-4px);border-color:rgba(34,211,238,.4);box-shadow:0 18px 50px -20px rgba(0,0,0,.7)}
.card:hover::before{opacity:1}
.card .idx{font-family:var(--mono);font-size:.7rem;color:var(--faint);letter-spacing:.14em}
.card h3{font-size:1.3rem;letter-spacing:-.02em}
.card p{font-size:.94rem;color:var(--muted);flex:1}
.card .links{display:flex;gap:16px;margin-top:.4rem}
.card .links a{font-family:var(--mono);font-size:.76rem;letter-spacing:.06em;color:var(--accent);text-decoration:none}
.card .links a:hover{text-decoration:underline;text-underline-offset:4px}
@media(max-width:900px){.grid3{grid-template-columns:1fr}}

/* contact */
.contact-panel{background:var(--glass),var(--solid);border:1px solid var(--border);border-radius:20px;padding:clamp(2rem,5vw,3.5rem);
  position:relative;overflow:hidden}
.contact-panel::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(560px 240px at 50% -80px, var(--accent-glow), transparent 70%)}
.contact-panel h2{font-size:clamp(1.8rem,4vw,2.7rem);margin-bottom:10px;position:relative}
.contact-panel>p{color:var(--muted);margin-bottom:32px;position:relative}
.linkrows{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative}
@media(max-width:640px){.linkrows{grid-template-columns:1fr}}
.lrow{display:flex;align-items:center;justify-content:space-between;gap:12px;text-decoration:none;
  border:1px solid var(--border-soft);border-radius:10px;padding:.95rem 1.15rem;color:var(--text);
  transition:border-color .2s,background .2s,transform .2s var(--ease)}
.lrow:hover{border-color:rgba(34,211,238,.45);background:rgba(34,211,238,.05);transform:translateY(-2px)}
.lrow .n{font-weight:600;font-size:.95rem}
.lrow .u{font-family:var(--mono);font-size:.7rem;color:var(--faint)}
.lrow .arr{color:var(--accent);font-family:var(--mono)}

/* footer */
footer{border-top:1px solid var(--border-soft);padding:2.2rem 0 2.6rem;margin-top:40px}
.foot{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.foot p{font-family:var(--mono);font-size:.72rem;color:var(--faint);letter-spacing:.06em}
.foot a{color:var(--muted);font-size:.82rem;text-decoration:none}
.foot a:hover{color:var(--accent)}
.ver{font-family:var(--mono);font-size:.68rem;color:var(--amber);border:1px solid rgba(251,191,36,.3);
  border-radius:6px;padding:.25rem .6rem;letter-spacing:.08em}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .rv{opacity:1;transform:none}
  .caret{display:none}
}
</style>
</head>
<body>
