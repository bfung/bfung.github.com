</nav>

<main id="main">
  <header class="hero wrap">
    <p class="status rv"><span class="dot" aria-hidden="true"></span>systems operational · open to work</p>
    <h1 class="rv" style="--d:60ms">Benson Fung</h1>
    <p class="tagline rv" style="--d:120ms">build better, be better, <span class="boba">boba.</span></p>
    <p class="subline rv" style="--d:170ms">family, friends, food, fun.</p>
    <div class="ctas rv" style="--d:220ms">
      <a class="btn btn-primary" href="/vibe-redesign/tech-modern/resume/">View résumé</a>
      <a class="btn btn-ghost" href="https://github.com/bfung" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    </div>

    <div class="term rv" style="--d:280ms" role="img" aria-label="Terminal card showing a short profile of Benson Fung">
      <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>bfung — zsh</span></div>
      <div class="term-body" id="termBody" aria-hidden="true"><div><span class="p">$ whoami</span></div><div><span class="o">benson-fung — systems &amp; people team builder</span></div><div><span class="p">$ cat focus.txt</span></div><div><span class="o">transparency · efficiency · simplification</span></div><div><span class="p">$ uptime --career</span></div><div><span class="o">20+ years · 7 roles · 0 downtime</span></div></div>
    </div>

    <div class="stats">
      <div class="stat rv" style="--d:0ms"><b>20<em>+</em></b><span>years shipping</span></div>
      <div class="stat rv" style="--d:60ms"><b>07</b><span>roles held</span></div>
      <div class="stat rv" style="--d:120ms"><b>32</b><span>skills in stack</span></div>
      <div class="stat rv" style="--d:180ms"><b>03</b><span>featured builds</span></div>
    </div>
  </header>

  <section id="projects" aria-labelledby="proj-h">
    <div class="wrap">
      <p class="eyebrow rv">projects</p>
      <h2 class="sec-title rv" id="proj-h" style="--d:60ms">Featured builds</h2>
      <p class="sec-sub rv" style="--d:120ms">Shipped, working, and inspectable. Source available unless noted.</p>
      <div class="grid3">
        <article class="card rv" style="--d:0ms">
          <span class="idx">01</span>
