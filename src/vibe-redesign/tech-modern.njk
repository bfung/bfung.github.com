<script>
(function(){
  document.documentElement.classList.remove('no-js');
  document.documentElement.classList.add('js');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* nav blur on scroll */
  var nav = document.getElementById('nav');
  var tick = false;
  function onScroll(){ tick = false; nav.classList.toggle('scrolled', window.scrollY > 24); }
  window.addEventListener('scroll', function(){
    if(!tick){ tick = true; requestAnimationFrame(onScroll); }
  }, {passive:true});
  onScroll();

  /* reveal on scroll */
  var els = document.querySelectorAll('.rv');
  if('IntersectionObserver' in window && !reduce){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:.12, rootMargin:'0px 0px -36px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }

  /* typed terminal */
  var body = document.getElementById('termBody');
  var lines = [
    ['p','$ whoami'],
    ['o','benson-fung — systems & people team builder'],
    ['p','$ cat focus.txt'],
    ['o','transparency · efficiency · simplification'],
    ['p','$ uptime --career'],
    ['o','20+ years · 7 roles · 0 downtime']
  ];
  function renderStatic(){
    body.innerHTML = lines.map(function(l){
      return '<div><span class="'+l[0]+'">'+l[1].split('').map(function(ch){
        return ch === '<' ? '&lt;' : ch === '>' ? '&gt;' : ch === '&' ? '&amp;' : ch;
      }).join('')+'</span></div>';
    }).join('');
  }
  if(reduce || !('IntersectionObserver' in window)){ renderStatic(); return; }
  var li = 0, ci = 0, html = '', started = false;
  function typeLine(){
    if(li >= lines.length){
      body.innerHTML = html + '<div><span class="caret"></span></div>';
      return;
    }
    var cls = lines[li][0], txt = lines[li][1];
    if(ci === 0){ html += '<div><span class="'+cls+'">'; }
    if(ci < txt.length){
      var ch = txt[ci];
      html += ch === '<' ? '&lt;' : ch === '>' ? '&gt;' : ch === '&' ? '&amp;' : ch;
      ci++;
      body.innerHTML = html + '</span><span class="caret"></span></div>';
      setTimeout(typeLine, cls === 'p' ? 42 : 16);
    } else {
      html += '</span></div>'; li++; ci = 0;
      body.innerHTML = html;
      setTimeout(typeLine, 260);
    }
  }
  var tio = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(e.isIntersecting && !started){ started = true; body.innerHTML = ''; typeLine(); tio.disconnect(); }
    });
  }, {threshold:.4});
  tio.observe(body);
})();
</script>
</body>
</html>
