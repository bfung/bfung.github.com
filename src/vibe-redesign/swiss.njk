  <section id="contact" class="band" aria-label="Contact">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num" aria-hidden="true">02</span>
        <h2 class="sec-title">contact</h2>
      </div>
      <ul class="contact-list">
        <li class="reveal"><a href="https://www.linkedin.com/in/bensonfung" target="_blank" rel="noopener"><span class="c-name">linkedin</span><span class="c-url">linkedin.com/in/bensonfung</span></a></li>
        <li class="reveal"><a href="https://github.com/bfung" target="_blank" rel="noopener"><span class="c-name">github</span><span class="c-url">github.com/bfung</span></a></li>
        <li class="reveal"><a href="https://stackoverflow.com/users/45793/benson" target="_blank" rel="noopener"><span class="c-name">stackoverflow</span><span class="c-url">stackoverflow.com/users/45793/benson</span></a></li>
        <li class="reveal"><a href="https://news.ycombinator.com/user?id=bfung" target="_blank" rel="noopener"><span class="c-name">hacker news</span><span class="c-url">news.ycombinator.com/user?id=bfung</span></a></li>
        <li class="reveal"><a href="https://benson-guides.blogspot.com/" target="_blank" rel="noopener"><span class="c-name">guides</span><span class="c-url">benson-guides.blogspot.com</span></a></li>
        <li class="reveal"><a href="https://twitter.com/fungbenson" target="_blank" rel="noopener"><span class="c-name">twitter</span><span class="c-url">twitter.com/fungbenson</span></a></li>
