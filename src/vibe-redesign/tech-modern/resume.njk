<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Résumé — Tech Modern | VibeRedesign</title>
<meta name="description" content="Benson Fung's résumé in the 2026 dev-tool aesthetic: changelog-style roles, mono metadata, luminous cyan accents.">
<link rel="canonical" href="https://bfung.github.io/vibe-redesign/tech-modern/resume/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Benson Fung">
<meta property="og:title" content="Résumé — Tech Modern | VibeRedesign">
<meta property="og:description" content="Changelog-style résumé: dark substrate, mono metadata, luminous cyan accents.">
<meta property="og:url" content="https://bfung.github.io/vibe-redesign/tech-modern/resume/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Résumé — Tech Modern | VibeRedesign">
<meta name="twitter:description" content="Changelog-style résumé: dark substrate, mono metadata, luminous cyan.">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<!-- Vibe carryover: records this vibe so base.njk pages keep its look. See src/assets/js/vibe.js. -->
<script src="{{ '/assets/js/vibe.js' | cacheBust }}"></script>
<style>
:root{
  --bg:#05070A;
  --bg2:#0A0E13;
  --panel:#0C1218;
  --glass:linear-gradient(180deg, rgba(148,163,184,.075), rgba(148,163,184,.022));
  --solid:linear-gradient(180deg, rgba(17,25,35,.94), rgba(9,14,20,.94));
  --border:rgba(148,163,184,.14);
  --border-soft:rgba(148,163,184,.08);
  --text:#E8EEF4;
  --muted:#8B98AB;
  --faint:#5B6B7E;
  --accent:#22D3EE;
  --accent-dim:rgba(34,211,238,.12);
  --accent-glow:rgba(34,211,238,.32);
  --amber:#FBBF24;
  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
  --ease:cubic-bezier(.22,1,.36,1);
  --r:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:1.0625rem;line-height:1.65;
  -webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:var(--accent);color:#03181c}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3{line-height:1.12;letter-spacing:-.03em;font-weight:800}
.bg-dots{position:fixed;inset:0;z-index:0;pointer-events:none;transform:translateZ(0);
  background-image:radial-gradient(rgba(148,163,184,.14) 1px, transparent 1.4px);
  background-size:28px 28px;
  -webkit-mask-image:radial-gradient(ellipse 90% 62% at 50% -4%, #000 25%, transparent 78%);
  mask-image:radial-gradient(ellipse 90% 62% at 50% -4%, #000 25%, transparent 78%)}
.orb{position:fixed;z-index:0;pointer-events:none;border-radius:50%;
  width:560px;height:380px;left:50%;top:-160px;transform:translateX(-50%) translateZ(0);
  background:radial-gradient(closest-side, rgba(34,211,238,.14), transparent 70%)}
.wrap{max-width:960px;margin:0 auto;padding:0 24px;position:relative;z-index:1}
.skip{position:fixed;top:-64px;left:16px;z-index:200;background:var(--accent);color:#03181c;
  font-family:var(--mono);font-size:.8rem;font-weight:700;padding:.7rem 1.1rem;border-radius:8px;
  text-decoration:none;transition:top .2s}
.skip:focus{top:12px}

.nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:background .25s,border-color .25s;border-bottom:1px solid transparent}
.nav.scrolled{background:rgba(5,7,10,.92);border-bottom-color:var(--border-soft)}
.nav-in{max-width:960px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{font-family:var(--mono);font-size:.95rem;font-weight:700;color:var(--text);text-decoration:none}
.brand b{color:var(--accent)}
.nav-links{display:flex;gap:26px;list-style:none;align-items:center}
.nav-links a{font-size:.86rem;color:var(--muted);text-decoration:none;transition:color .18s}
.nav-links a:hover{color:var(--text)}
.nav-links a.hl{color:var(--accent);font-weight:600}
@media(max-width:640px){.nav-links{gap:16px}.nav-links a{font-size:.78rem}}

.js .rv{opacity:0;transform:translateY(14px);transition:opacity .28s var(--ease),transform .28s var(--ease);transition-delay:var(--d,0ms)}
.js .rv.in{opacity:1;transform:none}

.back{font-family:var(--mono);font-size:.78rem;color:var(--muted);text-decoration:none;letter-spacing:.04em}
.back:hover{color:var(--accent)}
.rhead{padding:132px 0 40px}
.status{display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:.5rem 1rem;margin:22px 0 26px;
  background:rgba(12,18,24,.6)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex:none;position:relative}
.dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--accent);animation:ping 2.2s var(--ease) infinite}
@keyframes ping{0%{transform:scale(1);opacity:.55}60%,100%{transform:scale(2.8);opacity:0}}
.rhead h1{font-size:clamp(2.6rem,7vw,4.5rem);margin-bottom:10px;
  background:linear-gradient(180deg,#fff 25%,#9FB0C3 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
@supports not ((-webkit-background-clip:text) or (background-clip:text)){.rhead h1{color:var(--text)}}
.role{font-family:var(--mono);font-size:.9rem;color:var(--accent);letter-spacing:.05em;margin-bottom:16px}
.summary{color:var(--muted);max-width:64ch;margin-bottom:26px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{font-family:var(--mono);font-size:.74rem;color:var(--muted);text-decoration:none;
  border:1px solid var(--border);border-radius:999px;padding:.5rem 1rem;transition:border-color .2s,color .2s,transform .2s var(--ease)}
.chip:hover{border-color:rgba(34,211,238,.5);color:var(--accent);transform:translateY(-1px)}

section{padding:64px 0;position:relative;scroll-margin-top:64px;content-visibility:auto;contain-intrinsic-size:auto 1100px}
.eyebrow{font-family:var(--mono);font-size:.74rem;letter-spacing:.18em;color:var(--accent);margin-bottom:26px}
.eyebrow::before{content:"~/";color:var(--faint)}

.job{border-top:1px solid var(--border-soft);padding:1.7rem .4rem;display:grid;
  grid-template-columns:190px 1fr;gap:8px 28px;transition:background .2s;
  content-visibility:auto;contain-intrinsic-size:auto 300px}
.job:last-of-type{border-bottom:1px solid var(--border-soft)}
.job:hover{background:rgba(148,163,184,.03)}
.job .when{font-family:var(--mono);font-size:.74rem;color:var(--faint);letter-spacing:.04em;padding-top:.3rem}
.job .when .now{display:inline-block;margin-top:8px;font-size:.64rem;letter-spacing:.12em;color:var(--amber);
  border:1px solid rgba(251,191,36,.35);border-radius:6px;padding:.2rem .55rem}
.job h3{font-size:1.28rem;margin-bottom:2px}
.job h3 a{color:var(--text);text-decoration:none}
.job h3 a:hover{color:var(--accent)}
.job .co{font-size:.9rem;color:var(--muted);margin-bottom:.8rem}
.job .co a{color:var(--muted);text-decoration:none;border-bottom:1px dotted var(--faint)}
.job .co a:hover{color:var(--accent);border-bottom-color:var(--accent)}
.job ul{list-style:none;margin-bottom:1rem;max-width:72ch}
.job ul li{position:relative;padding-left:1.2rem;margin-bottom:.45rem;font-size:.95rem;color:#C3CDD9}
.job ul li::before{content:"–";position:absolute;left:0;color:var(--accent)}
.job ul a{color:var(--text);text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:3px}
.tags{display:flex;flex-wrap:wrap;gap:8px}
.tags span{font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;color:var(--muted);
  background:var(--accent-dim);border:1px solid rgba(34,211,238,.22);border-radius:6px;padding:.28rem .65rem}
@media(max-width:700px){.job{grid-template-columns:1fr;gap:4px}.job .when{padding-top:0}.job .when .now{margin:4px 0 0 8px}}

.sec-title{font-size:clamp(1.9rem,4vw,2.7rem);margin-bottom:30px}
.stack{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.panel{background:var(--glass),var(--solid);border:1px solid var(--border-soft);border-radius:var(--r);padding:1.5rem;
  transition:border-color .2s,transform .2s var(--ease)}
.panel:hover{border-color:rgba(34,211,238,.35);transform:translateY(-2px)}
.panel h3{font-family:var(--mono);font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--accent);margin-bottom:1rem}
.panel p{font-size:.88rem;color:var(--muted);line-height:1.9}
@media(max-width:900px){.stack{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.stack{grid-template-columns:1fr}}

.edu{background:var(--glass);border:1px solid var(--border-soft);border-radius:var(--r);padding:1.6rem 1.8rem;
  display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.edu b{font-size:1.05rem;letter-spacing:-.01em}
.edu span{font-family:var(--mono);font-size:.72rem;color:var(--muted);letter-spacing:.06em}
.edu em{display:block;font-style:normal;font-size:.85rem;color:var(--muted);margin-top:2px}

footer{border-top:1px solid var(--border-soft);padding:2.2rem 0 2.6rem;margin-top:40px}
.foot{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.foot p{font-family:var(--mono);font-size:.72rem;color:var(--faint);letter-spacing:.06em}
.foot nav{display:flex;gap:20px}
.foot a{color:var(--muted);font-size:.82rem;text-decoration:none}
.foot a:hover{color:var(--accent)}
.ver{font-family:var(--mono);font-size:.68rem;color:var(--amber);border:1px solid rgba(251,191,36,.3);
  border-radius:6px;padding:.25rem .6rem;letter-spacing:.08em}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .rv{opacity:1;transform:none}
}
</style>
  <!-- Datadog RUM -->
  <script src="/assets/js/rum-init.js?v=1.0.0" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="bg-dots" aria-hidden="true"></div>
<div class="orb" aria-hidden="true"></div>

<nav class="nav" id="nav" aria-label="Primary">
  <div class="nav-in">
    <a class="brand" href="/vibe-redesign/tech-modern/">bfung<b>_</b></a>
    <ul class="nav-links">
      <li><a href="#experience">Experience</a></li>
      <li><a href="#stack">Stack</a></li>
      <li><a class="hl" href="/vibe-redesign/tech-modern/">← Home</a></li>
    </ul>
  </div>
</nav>

<main id="main">
  <header class="rhead wrap">
    <a class="back rv" href="/vibe-redesign/tech-modern/">← back to home</a>
    <p class="status rv" style="--d:60ms"><span class="dot" aria-hidden="true"></span>last deployed · {{ resume.experience[0].start | lower }} — {{ resume.experience[0].end | lower }}</p>
    <h1 class="rv" style="--d:100ms">{{ site.name }}</h1>
    <p class="role rv" style="--d:140ms">{{ profile.title }}</p>
    <p class="summary rv" style="--d:180ms">{{ profile.summary }}</p>
    <div class="chips rv" style="--d:220ms">
      <span class="chip">{{ profile.location }}</span>
      {% for s in profile.socials %}{% if s.id == "linkedin" or s.id == "github" or s.id == "stackoverflow" %}<a class="chip" href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label | lower }} ↗</a>
      {% endif %}{% endfor %}    </div>
  </header>

  <section id="experience" aria-labelledby="exp-h">
    <div class="wrap">
      <p class="eyebrow rv">experience</p>
      <h2 class="sec-title rv" id="exp-h" style="--d:60ms">Changelog</h2>

      {% for job in resume.experience %}
      <article class="job rv">
        <p class="when">{{ job.start }} — {{ job.end }}{% if loop.first %}<br><span class="now">● CURRENT</span>{% endif %}</p>
        <div>
          <h3>{{ job.title }}</h3>
          <p class="co">{% if job.companyUrl %}<a href="{{ job.companyUrl }}" target="_blank" rel="noopener">{{ job.company }}</a>{% else %}{{ job.company }}{% endif %}{% if job.companyNote %} ({{ job.companyNote }}){% endif %} · {{ job.location }}</p>
          <ul>
            {% for b in job.bulletsHtml %}<li>{{ b | safe }}</li>
            {% endfor %}
          </ul>
          <div class="tags">{% for tag in job.tags %}<span>{{ tag }}</span>{% endfor %}</div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="stack" aria-labelledby="stack-h">
    <div class="wrap">
      <p class="eyebrow rv">stack</p>
      <h2 class="sec-title rv" id="stack-h" style="--d:60ms">Dependencies</h2>
      <div class="stack">
        <div class="panel rv" style="--d:0ms"><h3>core-expertise</h3><p>{{ resume.coreSkills | join(", ") }}</p></div>
        {% for group in resume.skillGroups %}
        <div class="panel rv" style="--d:{{ (loop.index % 3) * 60 }}ms"><h3>{% if loop.index == 1 %}languages{% elif loop.index == 2 %}infra{% elif loop.index == 3 %}data-platforms{% elif loop.index == 4 %}aws{% elif loop.index == 5 %}cicd-observability{% endif %}</h3><p>{{ group.items | join(", ") }}</p></div>
        {% endfor %}
      </div>
  </section>

  <section aria-labelledby="edu-h">
    <div class="wrap">
      <p class="eyebrow rv">education</p>
      <div class="edu rv">
        <div><b id="edu-h">{{ resume.education.school }}</b><em>{{ resume.education.degree }} · {{ resume.education.detail }}</em></div>
        <span>{{ resume.education.start }} — {{ resume.education.end }}</span>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot">
    <p>© 2026 {{ site.name }} · <span class="ver">v4.0 tech-modern</span></p>
    <nav aria-label="Footer">
      <a href="/vibe-redesign/tech-modern/">← Home</a>
      <a href="/vibe-redesign/">All vibes</a>
    </nav>
  </div>
</footer>

<script>
(function(){
  document.documentElement.classList.remove('no-js');
  document.documentElement.classList.add('js');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var nav = document.getElementById('nav');
  var tick = false;
  function onScroll(){ tick = false; nav.classList.toggle('scrolled', window.scrollY > 24); }
  window.addEventListener('scroll', function(){
    if(!tick){ tick = true; requestAnimationFrame(onScroll); }
  }, {passive:true});
  onScroll();

  var els = document.querySelectorAll('.rv');
  if('IntersectionObserver' in window && !reduce){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:.1, rootMargin:'0px 0px -30px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }
})();
</script>
</body>
</html>
