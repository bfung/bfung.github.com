---
layout: base.njk
title: Benson Fung | Software Systems & People Team Builder
description: Personal website of Benson Fung, a product-focused generalist software systems and engineering leader.
---

<section class="hero-section">
  <div class="avatar-container">
    <img src="{{ profile.avatar }}?s=192" alt="Benson Fung Profile Picture" class="avatar" width="96" height="96" loading="eager">
  </div>
  <h1>{{ site.name }}</h1>
  <p class="hero-tagline">
    {{ profile.taglinePrimary }}
  </p>
  <p class="hero-sub">
    {{ profile.taglineSecondary }}
  </p>
  <div class="hero-buttons">
    <a href="/resume/" class="btn btn-primary">
      Read Resume
    </a>
    {% for s in profile.socials %}{% if s.id == "github" %}<a href="{{ s.url }}" target="_blank" rel="noopener" class="btn btn-secondary">{% endif %}{% endfor %}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
      GitHub Profile
    </a>
  </div>
</section>

<section class="projects-section">
  <h2>Projects</h2>
  <div class="projects-grid">
    {% for project in projects.items %}
    {% if loop.index <= 6 %}
      {% include "project-card.njk" %}
    {% endif %}
    {% endfor %}
  </div>
  <p class="projects-more"><a href="/projects/">View all projects &rarr;</a></p>
</section>

<section class="guides-section">
  <h2>Guides</h2>
  <div class="guides-grid">
    {% for guide in guides.items %}
    {% if loop.index <= 6 %}
      {% include "guide-card.njk" %}
    {% endif %}
    {% endfor %}
  </div>
  <p class="projects-more"><a href="/guides/">View all guides &rarr;</a></p>
</section>

<section class="social-section" style="margin-top: var(--space-xxl);">
  <h2>Connect & Links</h2>
  <p style="color: var(--color-text-muted); font-size: 0.95rem;">You can find me across these developer and community platforms:</p>
  <div class="social-grid">
    {% for s in profile.socials %}{% if s.id != "github" %}
    <a href="{{ s.url }}" target="_blank" rel="noopener" class="social-card">
      {% if s.id == "linkedin" %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>{% elif s.id == "stackoverflow" %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.5 11.5h19M3.5 15.5h17M5.5 19.5h13M4.5 7.5L18.8 12M7.8 3.8l12.7 6.4"></path>
      </svg>{% elif s.id == "hackernews" %}<span style="font-weight: 800; font-family: monospace; font-size: 1.1rem; line-height: 1; border: 1.5px solid currentColor; width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; border-radius: 2px;">Y</span>{% elif s.id == "blog" %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>{% elif s.id == "twitter" %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
      </svg>{% endif %}
      {{ s.label }}
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
