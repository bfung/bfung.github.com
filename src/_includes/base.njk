<!DOCTYPE html>
<html lang="en">
  <head>
    {% set pageTitle = title or "Benson Fung | Software Systems & People Team Builder" %}
    {% set pageDescription = description or "Portfolio and Resume of Benson Fung, a product-focused generalist software systems and engineering leader." %}
    {% set pageUrl = site.url + page.url %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    
    <!-- SEO Meta Tags -->
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ pageUrl }}">
    
    <!-- Favicon -->
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Benson Fung">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="https://www.gravatar.com/avatar/f4057026c971b50fb44fb0b190adccef?s=400">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="https://www.gravatar.com/avatar/f4057026c971b50fb44fb0b190adccef?s=400">
    
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Benson Fung",
      "url": "{{ site.url }}/",
      "image": "https://www.gravatar.com/avatar/f4057026c971b50fb44fb0b190adccef?s=400",
      "jobTitle": "Software Systems & People Team Builder",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Irvine",
        "addressRegion": "CA"
      },
      "sameAs": [
        "https://github.com/bfung",
        "https://www.linkedin.com/in/bensonfung",
        "https://stackoverflow.com/users/45793/benson",
        "https://news.ycombinator.com/user?id=bfung",
        "https://twitter.com/fungbenson"
      ]
    }
    </script>

    <!-- Declare supported color schemes for browser rendering and FOUC prevention -->
    <meta name="color-scheme" content="light dark">
    
    <!-- Inline script to apply saved theme preference immediately -->
    <script>
      {
        const savedTheme = localStorage.getItem("color-scheme");
        if (savedTheme) {
          document.querySelector('meta[name="color-scheme"]').content = savedTheme;
          document.documentElement.setAttribute('data-theme', savedTheme);
        }
      }
    </script>
    
    <!-- Premium Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css">
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand" id="brand-logo">Benson Fung</a>
        <nav class="site-nav" aria-label="Main Navigation">
          <ul class="nav-links">
            <li><a href="/" {% if page.url == "/" %}class="active" aria-current="page"{% endif %}>Home</a></li>
            <li><a href="/resume.html" {% if page.url == "/resume.html" %}class="active" aria-current="page"{% endif %}>Resume</a></li>
            <li><a href="/vibe-redesign/" {% if "/vibe-redesign" in page.url %}class="active" aria-current="page"{% endif %}>VibeRedesign</a></li>
          </ul>
        </nav>
        <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark/light mode" title="Toggle theme">
          <!-- SVG for Sun Icon (visible in Dark Mode) -->
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <!-- SVG for Moon Icon (visible in Light Mode) -->
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main-content" class="content-wrapper">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; 2026 Benson Fung. All rights reserved.</p>
        <p class="footer-meta">Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a> &bull; Blazing fast, build-time static HTML.</p>
      </div>
    </footer>

    <!-- Client-side JS -->
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
